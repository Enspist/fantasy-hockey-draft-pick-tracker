bot:
  # Your Discord server (guild) ID
  guild_id: 123456789012345678

  # The role that can use admin bot commands (name or role ID)
  admin_role: Commissioner

  # OPTIONAL: a role that can ONLY run /bot restart (manage the bot) but
  # cannot change trades, teams, or picks. Leave blank/null to disable.
  bot_admin_role:

  # The Discord channel ID where the draft pick board embeds are posted
  picks_channel: 987654321098765432

  # How many bot log files to keep before the oldest is deleted (default 5)
  log_keep: 5
