[Unit]
Description=Fantasy Hockey Draft Pick Tracker Discord Bot
After=network.target postgresql.service

[Service]
Type=simple
User=discord
WorkingDirectory=/opt/fantasy-hockey-bot
EnvironmentFile=/opt/fantasy-hockey-bot/.env
ExecStart=/opt/fantasy-hockey-bot/venv/bin/python main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
